# Скопировать в .env (рядом с docker-compose.yml) и заполнить на сервере.
# .env в git не попадает. После изменения: docker compose up -d web

# --- Форма «Let’s talk» на /v2: письма на info@ через Microsoft Graph ---
# Даёт администратор Microsoft 365 (Entra ID -> App registrations):
CONTACT_TENANT_ID=
CONTACT_CLIENT_ID=
CONTACT_CLIENT_SECRET=
# Ящик, от имени которого уходит письмо (например noreply@dc-valley.com)
CONTACT_SENDER=
# Кому приходят заявки (можно несколько через запятую)
CONTACT_TO=info@dc-valley.com
